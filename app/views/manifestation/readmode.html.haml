.reading-mode
  #content.container-fluid
    .row.text-page-content
      .col-12.col-lg-8
        .logo-for-print
          %img.logoBY-v02{:alt => t(:logo), :src => "/assets/logo-byp-mobile.svg"}
        .by-card-v02.rm-control-panel
          .rm-control-top
            .rm-logo
              %img.logoBY-v02{:alt => t(:logo), src: "/assets/logo-byp.svg"}
            %a.collapse-expand-icon{href: manifestation_path(@m.id), title: t(:leave_readmode_tt)}
              %span.by-icon-v02 .
          .rm-control-info
            .headline-2-v02.work-name-top{style:'margin-right:0px'}= @m.title
            .headline-3-v02
              != @m.authors.map { |t| authority_link(t) }.join(', ')
            - if @e.translation && @e.translators.size > 0
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.translator')}: "
                != @translators.map { |t| authority_link(t) }.join(', ')
            - if @illustrators.present?
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.illustrator')}: "
                != @illustrators.map { |t| authority_link(t) }.join(', ')
            - if @photographers.present?
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.photographer')}: "
                != @photographers.map { |t| authority_link(t) }.join(', ')
            - if @annotators.present?
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.annotator')}: "
                != @annotators.map { |t| authority_link(t) }.join(', ')
            - if @designers.present?
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.designer')}: "
                != @designers.map { |t| authority_link(t) }.join(', ')
            - if @editors.present?
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.editor')}: "
                != @editors.map { |t| authority_link(t) }.join(', ')
            - if @contributors.present?
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.contributor')}: "
                != @contributors.map { |t| authority_link(t) }.join(', ')
            - if @others.present?
              .headline-3-v02
                = "#{t('involved_authority.abstract_roles.other')}: "
                != @others.map { |t| authority_link(t) }.join(', ')
            - nav_items = @chapters.map { |ch| [ch[0], "ch#{ch[1]}"] }
            = render partial: 'shared/readmode_nav',
                     locals: { items: nav_items, field_label: t(:chapter) + ':',
                               no_next: t(:no_next_chapter), no_prev: t(:no_prev_chapter) }
            .rm-field-label= t(:location_in_work)
            .progress-outside
              .progress-inside.progress-bar
            .progress-number= '0%'
          .rm-control-icons
            .notyet{title: t(:readmode_search_tt)}
              %span.linkcolor.pointer.by-icon-v02 X
            .notyet{title: t(:bookmark_tt)}
              %span.linkcolor.pointer.by-icon-v02 F
            .linkcolor.pointer#found_mistake{title: t(:report_error_tt)}
              %button.error-found-btn.by-icon-v02.pointer{style:'background-color:unset; border-color: transparent; box-shadow:unset;padding-top:2px;'} g
            .linkcolor.pointer{'data-toggle' => 'modal', 'data-target' => '#shareDlg', title: t(:share_tt)}
              %span.by-icon-v02 U
            .notyet{title: t(:readmode_settings_tt)}
              %a{:href => "#"}
                %span.by-icon-v02 :
        .by-card-v02.rm-control-panel-mobile
          .rm-logo
            %img.logoBY-v02{:alt => "", :src => "/assets/logo-byp.svg"}
          .progress-area
            .progress-outside
              .progress-inside.progress-bar
              .progress-handle
            .progress-number= '0%'
          #text-moreMobile.by-dropdown-v02
            %span#text-nav-more.notyet
              %a{:href => "#"}
                %span.by-icon-v02 Y
            #text-menu-more.by-dropdown-content-v02
              %a{:href => "#"} &#x5DE;&#x5E2;&#x5D1;&#x5E8; &#x5DC;&#x5E4;&#x5E8;&#x5E7;...
              %a{:href => "#"}
                %span.by-icon-v02> X
                \&#x5D7;&#x5D9;&#x5E4;&#x5D5;&#x5E9; &#x5D1;&#x5D9;&#x5E6;&#x5D9;&#x5E8;&#x5D4;
              %a{:href => "#"}
                %span.by-icon-v02> b
                \&#x5D4;&#x5D5;&#x5E1;&#x5E4;&#x5EA; &#x5E1;&#x5D9;&#x5DE;&#x5E0;&#x5D9;&#x5D4;
              %a{:href => "#"}
                %span.by-icon-v02> g
                \&#x5DE;&#x5E6;&#x5D0;&#x5EA;&#x5D9; &#x5E9;&#x5D2;&#x5D9;&#x5D0;&#x5D4;
              %a{:href => "#"}
                %span.by-icon-v02> U
                \&#x5E9;&#x5D9;&#x5EA;&#x5D5;&#x5E3;
              %a{:href => "#"}
                %span.by-icon-v02> :
                \&#x5D4;&#x5D2;&#x5D3;&#x5E8;&#x5D5;&#x5EA;
          .rm-control-left
            %a.collapse-expand-icon{href: manifestation_path(@m.id)}
              %span.by-icon-v02 .
        .row
          .col.work-side-menu-area
          .col
            .by-card-v02
              .work-area
                .work-content
                  - if @m.as_prose?
                    #actualtext.maintext-prose-body.search-margin{tabindex: 1}
                      != raw(@html)
                  - else
                    #actualtext.maintext-poetry-body.search-margin{tabindex: 1}
                      != raw(@html)
                .work-side-color
                  %div{'class' => "work-genre", style: "background-image: url(\"/assets/work_side_icons_#{@w.genre}.svg\"); background-repeat: no-repeat; background-size:auto;"}
/ found mistake popup
= render partial: 'shared/proof'

:javascript
  $(document).ready(function(){
    window.onscroll = function() {
      var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      var scrolled = (winScroll / height) * 100;
      if (scrolled > 100) {
        scrolled = 100;
      }
      $('.progress-bar').css('width', scrolled + "%");
      $('.progress-number').html(Math.ceil(scrolled) + '%');
      $('.progress-handle').css('right', Math.floor(scrolled) + '%');
    };
    $(document).on('keyup',function(evt) {
      if (evt.keyCode == 27) {
        window.location.href = '#{url_for(action: :read, id: @m.id)}';
      }
    });
  });
