%ol
  - links.each do |link|
    %li
      - if link.url.present?
        = link_to link.description, link.url
      - else
        = link.description
      = ' ('+t(link.linktype)+')'
      - if edit
        = link_to t(:destroy), url_for(action: :remove_link, link_id: link.id, id: @m.id), :data => { :confirm => t(:are_you_sure) }
