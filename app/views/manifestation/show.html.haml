.backend{style: 'padding-top: 20px;'}
  %p
    %b= link_to t(:edit_metadata), manifestation_edit_metadata_path(@m.id)
  %p
    %b= link_to t(:edit_markdown), manifestation_edit_path(@m.id)
  %p
    %b= link_to t(:render), url_for(action: :read, id: @m.id)
  -#
    A soft-deleted text is offered the undo instead of a second soft-deletion: this page is the
    only place an editor can still see it, since #read forwards even editors to the replacement.
  - may_delete = current_user&.has_bit?(:deletions)
  - if may_delete && @m.deprecated?
    %p
      - undo_opts = { method: :post, id: 'undo-soft-delete-btn',
                      data: { confirm: t(:undo_soft_delete_confirm) } }
      %b= link_to t(:undo_soft_delete), manifestation_undo_soft_delete_path(@m.id), undo_opts
  - elsif may_delete
    %p
      -# an href-less <a> is caught by Bootstrap's `a:not([href]):not([tabindex]) { color: inherit }`,
      -# which outranks the site's `a { color: #660248 }` and renders it black, unlike its siblings above
      %b= link_to t(:soft_delete_work), '#', data: { toggle: 'modal', target: '#softDeleteDlg' }
  - if @m.deprecated?
    %p.alert.alert-warning#soft-delete-status
      = t(:soft_delete_status_deprecated)
      - if @m.soft_redirect_target.present?
        = link_to @m.soft_redirect_target.title_and_authors, manifestation_show_path(@m.soft_redirect)
  - elsif may_delete
    .modal#softDeleteDlg{ 'aria-hidden' => 'true', role: 'dialog', tabindex: '-1' }
      = render partial: 'soft_delete_modal', locals: { manifestation: @m }
  %h1
    != "#{t(:work_details)}: #{@m.title} / #{linkify_people(@w.involved_authorities.map(&:authority))}"
    - if @e.translation
      != " / #{linkify_people(@e.translators)}"
  - unless @legacy_url.nil?
    %h2= link_to t(:legacy_url), @legacy_url
  %h2= t(:work_entity_details)
  %p
    %b= t(:title) + ': '
    = @w.title
  %p
    %b= t(:primary)+'? '
    = (@w.primary ? t(:yes) : t(:no))
  %p
    %b= t(:genre) + ': '
    = textify_genre(@w.genre)
  %p
    %b= t(:language) + ': '
    = textify_lang(@w.orig_lang)
  %p
    %b= t(:origlang_title)+': '
    = @w.origlang_title
  %p
    %b= t(:thedate) + ': '
    = @w.date
  %p
    %b= t(:comments)+':'
    %br
    = @w.comment
    = render partial: 'involved_authorities/list', locals: { item: @w, edit: false }
  = render partial: 'aboutnesses', locals: {edit: true, add: true}

  %h2= t(:expression_details)
  %p
    %b= t(:title) + ': '
    = @e.title
  %p
    %b= t(:thedate) + ': '
    = @e.date
  %p
    %b #{Manifestation.human_attribute_name(:period)}:
    = t(@e.period)
  %p
    %b #{Expression.human_attribute_name(:intellectual_property)}:
    = textify_intellectual_property(@e.intellectual_property)
  %p
    %b= t(:language) + ': '
    = textify_lang(@e.language)
  %p
    %b= t(:source_edition)+': '
    = @e.source_edition
  %p
    %b= t(:comments)+':'
    %br
    = @e.comment
    = render partial: 'involved_authorities/list', locals: { item: @e, edit: false }

  %h2= t(:manifestation_details)
  %p
    %b= t(:status)
    = t(@m.status)
  %p
    %b= t(:title) + ': '
    = @m.title
  %p
    %b= t(:alternate_titles) + ': '
    = @m.alternate_titles
  %p
    %b #{Manifestation.human_attribute_name(:sort_name)}:
    = @m.sort_title
  %p
    %b= t(:responsibility_statement) + ': '
    = @m.responsibility_statement
  %p
    %b= t(:publisher_details) + ': '
    != "#{@m.publisher}, #{@m.publication_place}&rlm;: #{@m.publication_date}."
  %p
    %b= t(:conversion_verified)+':'
    = (@m.conversion_verified ? t(:yes) : t(:no))
  %p
    %b= t(:comments)+':'
    %br
    = @m.comment
  %hr
  %h2= t(:external_links)
  = render partial: 'external_links', locals: { links: @m.external_links, edit: false }
  %hr
  %h2= t(:images)
  = render partial: 'images', locals: { m: @m}
  = render partial: 'add_images'
  %hr
  .read_html
    != raw(@html)
  %hr
  %b= link_to t(:edit_markdown), manifestation_edit_path(@m.id)
