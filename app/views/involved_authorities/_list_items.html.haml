- item.involved_authorities.each do |ia|
  %li{ id: "ia#{ia.id}" }
    = authority_link(ia.authority)
    = "(#{textify_authority_role(ia.role)})"
    - if edit
      = link_to t(:destroy), involved_authority_path(ia),
                remote: true, method: :delete, data: { confirm: t(:are_you_sure) }
