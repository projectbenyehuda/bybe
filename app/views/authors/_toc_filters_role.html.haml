-# Role section of the TOC filters pane: the roles whose TOC sections this page renders, gated
  exactly as the navbar and authors/_toc_by_role are (the counts skip collection-level roles).
:ruby
  top_nodes = @toc_tree.top_level_nodes
  roles = InvolvedAuthority::ROLES_PRESENTATION_ORDER.select do |role|
    toc_role_present?(toc_role_sections(top_nodes, role, @author.id))
  end
-# A single role has nothing to filter.
- if roles.size > 1
  = render layout: 'shared/collapsible_block',
           locals: { container_name: 'tocfrole', title: t(:role), content_class: 'nested-list' } do
    %ul
      - roles.each do |role|
        %li
          .filter-checkbox
            %input.toc-filter-role{ type: 'checkbox', value: role, name: 'toc_filter_role',
                                    id: "toc-filter-role-#{role}" }
            %label{ for: "toc-filter-role-#{role}" }
              = textify_role(role, @author.gender)
              %span.toc-facet-count{ 'data-section': 'role', 'data-value': role }
