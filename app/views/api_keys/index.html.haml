.container-fluid#content
  .row
    .col-12
      %h1= t('.title')
      %p
        = link_to t('.download_csv'), api_keys_path(format: :csv), class: 'btn btn-secondary', id: 'api_keys_csv'
        = link_to t('.new_key'), new_api_key_path, class: 'btn btn-primary'

      %table.table#api_keys_table
        %thead
          %tr
            %th= t('.email')
            %th= t('.description')
            %th= t('.key')
            %th= t('.status')
            %th= t('.calls_count')
            %th= t('.last_used_at')
            %th
        %tbody
          - @api_keys.each do |api_key|
            %tr{ id: "api_key_#{api_key.id}" }
              %td= api_key.email
              %td= api_key.description
              %td= api_key.key
              %td
                %span.badge{ class: api_key.status_enabled? ? 'badge-success' : 'badge-danger' }
                  = t(".statuses.#{api_key.status}")
              %td.calls-count= number_with_delimiter(api_key.calls_count)
              %td.last-used-at= api_key.last_used_at ? l(api_key.last_used_at, format: :short) : t('.never_used')
              %td
                .btn-group
                  - if api_key.status_enabled?
                    = button_to t('.disable'), toggle_status_api_key_path(api_key, page: params[:page]),
                                method: :patch, class: 'btn btn-warning', form_class: 'd-inline',
                                data: { confirm: t('.confirm_disable', email: api_key.email) }
                  - else
                    = button_to t('.enable'), toggle_status_api_key_path(api_key, page: params[:page]),
                                method: :patch, class: 'btn btn-success', form_class: 'd-inline'
                  = link_to t('.edit'), edit_api_key_path(api_key), class: 'btn btn-primary'
                  = link_to t('.destroy'), api_key, method: :delete, data: { confirm: t('.confirm_destroy') },
                                                    class: 'btn btn-danger'
      != paginate @api_keys
