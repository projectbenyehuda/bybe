BY_LANGUAGE=he # locale used for UI
ELASTICSEARCH_HOST=127.0.0.1:19200

# Puma parallelism settings
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=3

# NOTE: by default Rails disables caching in development or test environments.
# You can toggle it by running command `rails dev:cache` or `rails test:cache`
MEMCACHE_SERVERS=127.0.0.1:21211

APP_HOSTNAME=benyehuda.org

# BELOW ARE SENSITIVE KEYS WE EXPECT YOU TO FILL IN .local FILES
# e.g. .env.development.local, .env.test.local

# Amazon S3 storgae used by ActiveStorage and Paperclip gem
S3_BUCKET=bybeprod
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=sample-access-key-id
AWS_SECRET_ACCESS_KEY=sample-secret-access-key

# For youtube integration
GOOGLE_API_KEY=google_api_key

# To communicate with our tasks system
TASK_SYSTEM_HOST=localhost
TASK_SYSTEM_PORT=3001

# Used to login into app using google account
GOOGLE_OAUTH_CLIENT_ID=google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=google_oauth_client_secret

# Used by RubyLLM to analyze lexicon files
OPENAI_API_KEY=your_openai_api_key_here

# We use Monday.com to track editorial to-dos, and it has a convenient API so that we can report and escalate issues
# from within the lexicon migration flow.
MONDAY_BOARD_ID=monday_board_id
MONDAY_API_TOKEN=monday_api_token
LEXICON_MIGRATED_MONDAY_BOARD_ID=board_id

# Path to the old benyehuda.org lexicon (No 'http://', 'www.' prefixes, no trailing slash!)
OLD_LEXICON_PATH=benyehuda.org/lexicon

# Bugtracking
SENTRY_DSN=sentry_dsn

# To be removed ater we remove HtmlFiles completely
BASE_DIR=/var/www/my_actual_static_files_dir
